        "$type": "letterSpacing",
        "$value": "0"
      },
      "increased": {
        "$type": "letterSpacing",
        "$value": "150%"
      },
      "decreased": {
        "$type": "letterSpacing",
        "$value": "-5%"
      }
    },
    "paragraphSpacing": {
      "h1": {
        "$type": "paragraphSpacing",
        "$value": "32"
      },
      "h2": {
